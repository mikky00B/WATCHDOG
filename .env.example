# Database Configuration
DATABASE_URL=postgresql+asyncpg://monitoring_user:monitoring_pass@localhost:5432/monitoring_db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
APP_ENV=development
AUTO_CREATE_TABLES=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]

# Monitoring Configuration
DEFAULT_CHECK_INTERVAL=60
DEFAULT_TIMEOUT=5.0
MAX_CONCURRENT_CHECKS=100

# Email Configuration (Resend)
EMAIL_ENABLED=true
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=alerts@monitoring.com
FROM_NAME="Michael from Watchdog"

# Telegram Configuration (for Telegram alerts + bot control)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/integrations/telegram/webhook
TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321

# Logging
LOG_LEVEL=INFO
